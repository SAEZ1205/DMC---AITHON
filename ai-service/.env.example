# DMC RescuePath AI - Configuración de Entorno
# Copia este archivo como .env (NUNCA lo subas a Git: .env está en .gitignore).
# Este archivo contiene solo valores de ejemplo; no escribas aquí una clave real.

# ---------------------------------------------------------------------------
# Proveedor de lenguaje
#   demo  (por defecto)  -> respuestas con plantillas, sin red y sin costo.
#   kimi / moonshot      -> Kimi (Moonshot AI) en modo LIVE. API DE PAGO por tokens.
# LIVE solo se activa si se cumplen LAS TRES condiciones:
#   1) LLM_PROVIDER=kimi   2) LLM_API_KEY definida   3) LLM_LIVE_AUTHORIZED=true
# Si falta alguna, el servicio sigue en DEMO (y /health indica el motivo).
# ---------------------------------------------------------------------------
LLM_PROVIDER=demo
LLM_API_KEY=
# Autorización explícita de gasto: déjalo en false hasta que alguien con presupuesto apruebe las llamadas.
LLM_LIVE_AUTHORIZED=false

# Endpoint y modelo (documentación oficial: https://platform.kimi.ai/docs/api/chat)
LLM_BASE_URL=https://api.moonshot.ai/v1
# Modelos vigentes: kimi-k2.6, kimi-k3, kimi-k2.7-code, kimi-k2.7-code-highspeed
# kimi-k2.6 es el más económico de los generalistas y permite desactivar el razonamiento.
LLM_MODEL=kimi-k2.6

# Control de costo y de latencia
LLM_TIMEOUT_SECONDS=30.0
# Tope de tokens de SALIDA por respuesta (max_completion_tokens). Con kimi-k3, que siempre razona,
# sube este valor (p. ej. 2000) o la respuesta puede truncarse.
LLM_MAX_OUTPUT_TOKENS=700
# Solo kimi-k2.6: enabled | disabled (disabled = más barato y rápido)
LLM_THINKING=disabled
# Solo kimi-k3: low | high | max
LLM_REASONING_EFFORT=low
# Tope de llamadas LIVE por proceso (0 = sin tope). Protege contra gasto descontrolado.
LLM_MAX_LIVE_CALLS=100
# Mensajes previos enviados al modelo (acota costo y datos compartidos) y segmentos de transcripción por pregunta
LLM_MAX_HISTORY_MESSAGES=6
LLM_MAX_EVIDENCE=3

# Si Kimi falla de forma temporal (timeout, 5xx, 429, respuesta no verificable): true = responder con DEMO
# avisándolo en la respuesta (mode=DEMO, fallback_used=true); false = devolver el error.
# Un error de autenticación o de configuración SIEMPRE se devuelve como error, nunca se oculta.
LLM_FALLBACK_TO_DEMO=true

# ---------------------------------------------------------------------------
# NVIDIA Build: Kimi K3 alojado (acceso gratuito de prueba, sujeto a límites de uso)
# ---------------------------------------------------------------------------
# Activar el chat con NVIDIA exige DOS líneas en ai-service/.env (no aquí):
#     LLM_PROVIDER=nvidia
#     LLM_LIVE_AUTHORIZED=true
# La clave se escribe SOLO en ai-service/.env (ignorado por Git), nunca en este archivo.
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3
# Debe ser HTTPS y de un dominio *.nvidia.com (si no, el proveedor se rechaza para no enviar la clave a otro destino).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Tokens de salida por respuesta. Kimi K3 SIEMPRE razona y esos tokens cuentan: no bajes de ~512 (el sistema aplica ese mínimo).
# Medido con la API de prueba: ~6 tokens/s (258 tokens en 42 s), así que 1200 tokens tardarían ~200 s y 700 caben en el timeout.
NVIDIA_MAX_OUTPUT_TOKENS=700
# Tiempo máximo de ESPERA por llamada a NVIDIA (5-300 s). Si se agota: respuesta DEMO con aviso visible, sin reintentos.
NVIDIA_TIMEOUT_SECONDS=120
# Tope TOTAL por pregunta del estudiante, sumando guardián y tutor (5-600 s). Nunca se espera más que esto.
NVIDIA_TOTAL_TIMEOUT_SECONDS=150
# El guardián es una llamada pequeña y opcional: si tarda más que esto se usa la heurística (3-120 s).
NVIDIA_GUARDIAN_TIMEOUT_SECONDS=25
# Nombre del parámetro de límite de tokens: max_completion_tokens (ejemplo oficial) o max_tokens.
NVIDIA_MAX_TOKENS_PARAM=max_completion_tokens
# response_format=json_object no está documentado para NVIDIA: apagado. El parseo tolera texto alrededor del JSON.
NVIDIA_JSON_MODE=false
# PRIVACIDAD: NVIDIA puede registrar entradas y salidas del servicio de prueba. Mientras sea false, el contenido de la
# clase REAL de DMC no se envía (el chat de esa clase responde en modo DEMO avisándolo). Cámbialo a true solo con
# autorización expresa y tras revisar scripts/review_privacy.py.
NVIDIA_ALLOW_CLASS_CONTENT=false
# Esfuerzo de razonamiento (low | high | max): low = más rápido y barato en tokens.
# (usa la misma variable LLM_REASONING_EFFORT definida arriba)

# ---------------------------------------------------------------------------
# Quiz, micro-pregunta y telemetría del asistente (Etapa 4) - todo con datos SINTÉTICOS de demostración
# ---------------------------------------------------------------------------
# Umbral DEMO para el estado "aprobado" del quiz (0-100). NO es una regla institucional y aprobar NO
# modifica asistencia ni implica certificación.
QUIZ_PASS_THRESHOLD_PERCENT=60
QUIZ_MAX_ATTEMPTS_PER_LESSON=3
QUIZ_ATTEMPT_TTL_MINUTES=60

# Micro-pregunta abierta opcional: una por periodo, tras completar un quiz.
# Fecha de referencia (YYYY-MM-DD, p. ej. inicio del curso). Vacía = la micro-pregunta no se muestra.
MICRO_QUESTION_REFERENCE_DATE=
MICRO_QUESTION_INTERVAL_DAYS=14
MICRO_QUESTION_REQUIRE_QUIZ=true

# Consulta de eventos individuales (GET /api/telemetry/events, cabecera X-Telemetry-Token).
# Vacío = endpoint DESHABILITADO. Usa un valor largo y aleatorio; no lo subas a Git.
TELEMETRY_API_TOKEN=
# Sal para los seudónimos de estudiante (student_ref). Cámbiala fuera de la demo.
TELEMETRY_PSEUDONYM_SALT=demo-salt-cambiar-en-produccion

# ---------------------------------------------------------------------------
# Clase REAL de demostración (Etapa 5) - material PRIVADO: demo-assets/ está excluida de Git
# ---------------------------------------------------------------------------
# Se cargan automáticamente si existen demo-assets/clase-demo.mp4 y demo-assets/transcripcion-original.txt
# (carpeta en la raíz del repositorio). Opcional: demo-assets/mask-names.txt con nombres extra a enmascarar.
REAL_LESSON_ENABLED=true
DEMO_ASSETS_DIR=
# Orígenes del frontend autorizados por CORS (separados por comas). Solo orígenes locales.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Token de acciones administrativas (regenerar resúmenes, incluido el de Kimi por fragmentos, que es de pago).
# Vacío = deshabilitadas. Usa un valor largo y aleatorio; no lo subas a Git.
ADMIN_API_TOKEN=

# ---------------------------------------------------------------------------
# Almacenamiento persistente SQLite (ruta relativa a la carpeta ai-service/, no al directorio de ejecución)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/rescuepath.db

# Configuración opcional para Supabase (todavía no se usa)
SUPABASE_URL=
SUPABASE_KEY=

# Webhook opcional para n8n (todavía no se usa)
N8N_WEBHOOK_URL=

# Configuración del servidor
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
