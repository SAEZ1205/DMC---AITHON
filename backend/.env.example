# Proveedor LLM compatible con OpenAI (Groq por defecto, plan gratuito).
# Crea la key en https://console.groq.com/keys. Nunca la subas al repositorio.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=...
LLM_MODEL_CHAT=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-120b
# Ventana de contexto del modelo en tokens.
LLM_CONTEXT_TOKENS=131072
# gpt-oss razona antes de responder y esos tokens cuentan en el cupo: low lo mantiene corto.
LLM_REASONING_EFFORT=low
# LLM_MOCK=1 fuerza el modo simulado (sin llamadas ni costo). Sin API key se activa solo.
LLM_MOCK=0

# Cupo del plan gratuito de Groq para openai/gpt-oss-120b (revisa https://console.groq.com/settings/limits).
# La app usa como máximo LLM_SAFETY de cada límite; sin cupo responde con la simulación en vez de fallar.
LLM_RPM=30
LLM_RPD=1000
LLM_TPM=8000
LLM_TPD=200000
LLM_SAFETY=0.85
# Segundos que una solicitud puede esperar cupo antes de usar la simulación.
LLM_MAX_WAIT_S=6
LLM_TIMEOUT_S=25

# Otros proveedores compatibles (cambia URL, key, modelos y cupo):
# Kimi:   LLM_BASE_URL=https://api.moonshot.ai/v1
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1

# Reloj simulado para la demo (mes 3 del curso de ejemplo). Déjalo vacío para usar la hora real.
SIM_NOW=2026-10-12T19:00:00

# DISABLE_SCHEDULER=1 desactiva el recálculo automático cada hora.
DISABLE_SCHEDULER=0
