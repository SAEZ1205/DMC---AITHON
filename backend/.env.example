# Proveedor LLM compatible con OpenAI (Kimi/Moonshot por defecto).
# Verifica en https://platform.moonshot.ai el nombre exacto del modelo habilitado para tu cuenta.
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_API_KEY=...
LLM_MODEL_CHAT=kimi-k2.6
LLM_MODEL_FAST=kimi-k2.6
# Ventana de contexto del modelo en tokens (para decidir si el chat usa BM25).
LLM_CONTEXT_TOKENS=256000
# LLM_MOCK=1 fuerza el modo simulado (sin llamadas ni costo). Sin API key se activa solo.
LLM_MOCK=0

# Alternativas (cambia solo las 3 primeras variables):
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1

# Reloj simulado para la demo (mes 3 del curso de ejemplo). Déjalo vacío para usar la hora real.
SIM_NOW=2026-10-12T19:00:00

# DISABLE_SCHEDULER=1 desactiva el recálculo automático cada hora.
DISABLE_SCHEDULER=0
